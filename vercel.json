{
  "builds": [
    {
      "src": "Backend/main.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["Backend/**"] }
    },
    { "src": "Frontend/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "Backend/main.py" },
    { "src": "/(.*)", "dest": "Frontend/$1" }
  ]
}